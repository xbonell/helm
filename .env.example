# Copy to .env and fill in values. Never commit .env.

# ── Shared secrets ──────────────────────────────────────────────
# openssl rand -hex 32
BETTER_AUTH_SECRET=replace-with-openssl-rand-hex-32
HERMES_API_SERVER_KEY=replace-with-openssl-rand-hex-32

# ── Paperclip ───────────────────────────────────────────────────
PAPERCLIP_PORT=3100
PAPERCLIP_PUBLIC_URL=http://localhost:3100
# Docker requires non-loopback bind → authenticated (local_trusted is loopback-only)
PAPERCLIP_DEPLOYMENT_MODE=authenticated
PAPERCLIP_DEPLOYMENT_EXPOSURE=private
PAPERCLIP_BIND=lan
PAPERCLIP_ALLOWED_HOSTNAMES=paperclip,localhost,127.0.0.1

# Optional LLM keys for Paperclip-local adapters (not required to start UI)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Hermes ──────────────────────────────────────────────────────
HERMES_API_PORT=8642
HERMES_DASHBOARD=0
HERMES_API_SERVER_CORS_ORIGINS=*
# HERMES_DASHBOARD_PORT=9119
# HERMES_DASHBOARD_BASIC_AUTH_USERNAME=
# HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=
# HERMES_DASHBOARD_BASIC_AUTH_SECRET=

# Optional model keys consumed by Hermes (written into data/hermes/.env by bootstrap)
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=

# Hermes Telegram (set in data/hermes/.env — not root .env)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_USERS=
# TELEGRAM_HOME_CHANNEL=

# ── Decider ─────────────────────────────────────────────────────
DECIDER_MODEL=Mapika/decider-2b
# cpu | mps | cuda | auto — image defaults to CPU torch wheels
DECIDER_DEVICE=cpu
# 0 = skip CUDA graph warm-up (required on CPU)
DECIDER_WARMUP=0

# ── Decision gateway ────────────────────────────────────────────
DECISION_GATEWAY_PORT=8081

# ── Model provider (Milestone 7+) ───────────────────────────────
MODEL_ROUTER_PORT=8082
# stub (default, free) | openai_compatible
MODEL_PROVIDER=stub
MODEL_NAME=stub/local
# MODEL_PROVIDER=openai_compatible
# MODEL_BASE_URL=https://openrouter.ai/api/v1
# MODEL_API_KEY=
# MODEL_NAME=openrouter/free

# ── Personal assistant / weather ────────────────────────────────
PERSONAL_ASSISTANT_PORT=8083
WEATHER_BASE_URL=https://api.open-meteo.com
# name:lat,lon entries separated by ;
WEATHER_LOCATIONS=Barcelona:41.3874,2.1686;Sant Cugat del Vallès:41.4728,2.0864

# ── Google Calendar (daily brief agenda) ────────────────────────
# OAuth read-only; refresh token from scripts/google-calendar-oauth.py
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
# Comma-separated calendar IDs (default in compose: primary)
# GOOGLE_CALENDAR_IDS=primary
